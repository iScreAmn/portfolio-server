# Образец для /opt/portfolio/.env на сервере. Скопировать, заполнить,
# выставить chmod 600. В репозиторий реальные значения не попадают.

# ─── Окружение ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5050

# ─── База данных ──────────────────────────────────────────────────────────
# Хост — имя сервиса из docker-compose. Пароль должен совпадать с POSTGRES_PASSWORD.
DATABASE_URL=postgresql://portfolio:change_me@db:5432/portfolio?schema=public

# Читает сам контейнер postgres в docker-compose. Пароль должен совпадать
# с тем, что стоит в DATABASE_URL.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change_me
POSTGRES_DB=portfolio

# ─── Сессии админки ───────────────────────────────────────────────────────
# Длинная случайная строка: `openssl rand -base64 48`.
# Смена секрета разлогинивает всех.
JWT_SECRET=

# Домен для кук. В проде — с ведущей точкой, чтобы кука с api.djcode.ge
# была видна и на djcode.ge. Локально оставить пустым.
COOKIE_DOMAIN=.djcode.ge

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── Первый пользователь админки ──────────────────────────────────────────
# Нужны только для `npm run db:seed`. После создания учётки можно убрать.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── CORS ─────────────────────────────────────────────────────────────────
# Через запятую. В проде — боевой домен; localhost добавляется сам,
# когда NODE_ENV != production.
CORS_ORIGIN=https://djcode.ge

# ─── Аналитика ────────────────────────────────────────────────────────────
# События принимаются только с этих хостов — иначе в статистику можно
# залить что угодно с чужой страницы.
ANALYTICS_ALLOWED_HOSTS=djcode.ge,www.djcode.ge
# 1 — приём событий отвечает 202, но ничего не пишет (аварийный выключатель).
ANALYTICS_DISABLED=

# ─── Формы ────────────────────────────────────────────────────────────────
# Ответ на «капчу» в форме контактов. Должен совпадать с тем, что
# отправляет фронт.
CONTACT_CAPTCHA_ANSWER=

# ─── Почта ────────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ─── Telegram ─────────────────────────────────────────────────────────────
# Пустой токен = уведомления выключены.
TELEGRAM_BOT_TOKEN=
# Можно перечислить несколько чатов через запятую.
TELEGRAM_CHAT_ID=
# Только для чатов с темами (форумов).
TELEGRAM_THREAD_ID=
