
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  owner
  developer
}


enum LeadType {
  contact
  calculator
  manual
}


enum LeadStatus {
  new
  in_progress
  promotion
  done
}


model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  passwordHash String @map("password_hash")
  role         Role   @default(admin)

  passwordUpdatedAt DateTime @default(now()) @map("password_updated_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}


model AnalyticsEvent {
  // Int, а не BigInt: 2.1 млрд событий портфолио не наберёт, зато id
  // безопасно уходит в JSON (BigInt ломает JSON.stringify).
  id         Int      @id @default(autoincrement())
  sessionId  String   @map("session_id")
  visitorId  String?  @map("visitor_id")
  occurredAt DateTime @map("occurred_at")
  receivedAt DateTime @default(now()) @map("received_at")

  category String
  action   String
  label    String?
  params   Json?

  path     String?
  url      String?
  hostname String?
  referrer String?

  sourceType  String? @map("source_type")
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmTerm     String? @map("utm_term")
  utmContent  String? @map("utm_content")

  deviceType   String? @map("device_type")
  os           String?
  browser      String?
  screenWidth  Int?    @map("screen_width")
  screenHeight Int?    @map("screen_height")

  locale   String?
  timezone String?

  country String?
  region  String?
  city    String?
  ip      String?

  @@index([occurredAt])
  @@index([sessionId, occurredAt])
  @@index([category, action, occurredAt])
  @@index([visitorId])
  @@map("analytics_events")
}

model Lead {
  id      String   @id @default(uuid()) @db.Uuid
  type    LeadType
  name    String
  company String?
  contact String
  method  String?
  message String?
  payload Json?

  status LeadStatus @default(new)
  note   String?

  sortOrder Int @default(0) @map("sort_order")

  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([sortOrder, createdAt])
  @@map("leads")
}


enum ReviewStatus {
  pending
  approved
}


model Review {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  company String?
  text    String

  photo String?
  logo  String?

  status     ReviewStatus @default(pending)
  approvedAt DateTime?    @map("approved_at")

  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("reviews")
}
